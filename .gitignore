# Allowlist: ignore everything at the repo root by default.
# To track a file or folder, add a `!/<name>` line below.
# An un-ignored folder is tracked in full; add normal ignore rules after it to exclude paths inside.
/*

!/.gitignore
!/LICENSE
!/AGENTS.md
!/docs/
!/.github/
!/.oxfmtrc.json
!/.oxlintrc.json
!/container/
!/fixtures/
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/scripts/
!/src/
!/test/
!/tsconfig.json
!/tsconfig.node.json
!/vite.config.ts
!/vitest.config.ts
!/worker-configuration.d.ts
!/wrangler.jsonc
node_modules/
