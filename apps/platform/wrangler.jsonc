{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "throng",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "throng-spike" }],
  "durable_objects": {
    "bindings": [
      { "name": "PROJECT", "class_name": "ProjectCoordinator" },
      { "name": "SANDBOX", "class_name": "RunSandbox" },
    ],
  },
  "exports": {
    "ProjectCoordinator": { "type": "durable-object", "storage": "sqlite" },
    "RunSandbox": { "type": "durable-object", "storage": "sqlite" },
    "CheckSandbox": { "type": "durable-object", "state": "renamed", "renamed_to": "RunSandbox" },
  },
  "containers": [
    {
      // The application keeps the name it was created with under CheckSandbox: renaming the class
      // kept its Durable Object namespace, and an application's name can't change.
      "name": "throng-checksandbox",
      "class_name": "RunSandbox",
      "scheduling_policy": "durable_object",
      "images": { "sandbox": { "dockerfile": "./container/Dockerfile" } },
    },
  ],
  "workflows": [{ "name": "throng-scoring", "binding": "SCORING", "class_name": "ScoringWorkflow" }],
  // Scoring run logs. R2's lifecycle rule (30 days on `logs/`) isn't wrangler config: see the README.
  "r2_buckets": [{ "binding": "LOGS", "bucket_name": "throng-logs" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "throng",
      // PLACEHOLDER: run `wrangler d1 create throng` and paste the id it prints here.
      "database_id": "65899f31-2d30-43f5-9588-708ae762809a",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "CF_ACCOUNT_ID": "9ff7e9e225aeb0ab0c56b05b42ca2b13",
    "PREVIEW_WORKER": "throng-fixture-worker",
    // PLACEHOLDER: the Zero Trust team domain and the Access application's audience (AUD) tag.
    "ACCESS_TEAM_DOMAIN": "gregjoeval.cloudflareaccess.com",
    "ACCESS_AUD": "2a713dce7fdf28f6d07c5954b0a9d57e867717b5af65ba730b98473b3366712b",
  },
  "secrets": { "required": ["SPIKE_TOKEN", "CF_PREVIEW_TOKEN"] },
  "observability": { "enabled": true },
  "env": {
    // The Worker the manual Integration workflow (.github/workflows/integration.yml) deploys and runs
    // `pnpm e2e` against. Select it with `CLOUDFLARE_ENV=ci`. Wrangler doesn't inherit bindings into
    // environments, so everything is repeated here with `throng-ci` resources.
    "ci": {
      "name": "throng-ci",
      "artifacts": [{ "binding": "ARTIFACTS", "namespace": "throng-ci" }],
      "durable_objects": {
        "bindings": [
          { "name": "PROJECT", "class_name": "ProjectCoordinator" },
          { "name": "SANDBOX", "class_name": "RunSandbox" },
        ],
      },
      "exports": {
        "ProjectCoordinator": { "type": "durable-object", "storage": "sqlite" },
        "RunSandbox": { "type": "durable-object", "storage": "sqlite" },
        "CheckSandbox": { "type": "durable-object", "state": "renamed", "renamed_to": "RunSandbox" },
      },
      "containers": [
        {
          "name": "throng-ci-checksandbox-ci",
          "class_name": "RunSandbox",
          "scheduling_policy": "durable_object",
          "images": { "sandbox": { "dockerfile": "./container/Dockerfile" } },
        },
      ],
      // Workflow names are account-wide, so they can't reuse production's.
      "workflows": [{ "name": "throng-ci-scoring", "binding": "SCORING", "class_name": "ScoringWorkflow" }],
      "r2_buckets": [{ "binding": "LOGS", "bucket_name": "throng-ci-logs" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "throng-ci",
          "database_id": "9a5b31f2-3bc8-418a-9e3a-b50539d4f03d",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "CF_ACCOUNT_ID": "9ff7e9e225aeb0ab0c56b05b42ca2b13",
        "PREVIEW_WORKER": "throng-fixture-worker",
        "ACCESS_TEAM_DOMAIN": "gregjoeval.cloudflareaccess.com",
        "ACCESS_AUD": "2a713dce7fdf28f6d07c5954b0a9d57e867717b5af65ba730b98473b3366712b",
      },
      "secrets": { "required": ["SPIKE_TOKEN", "CF_PREVIEW_TOKEN"] },
      "observability": { "enabled": true },
    },
  },
}
