{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "throng",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "throng-spike" }],
  "durable_objects": {
    "bindings": [
      { "name": "PROJECT", "class_name": "ProjectCoordinator" },
      { "name": "SANDBOX", "class_name": "CheckSandbox" },
    ],
  },
  "exports": {
    "ProjectCoordinator": { "type": "durable-object", "storage": "sqlite" },
    "CheckSandbox": { "type": "durable-object", "storage": "sqlite" },
  },
  "containers": [
    {
      "class_name": "CheckSandbox",
      "scheduling_policy": "durable_object",
      "images": { "sandbox": { "dockerfile": "./container/Dockerfile" } },
    },
  ],
  "workflows": [
    { "name": "throng-ingest", "binding": "INGEST", "class_name": "IngestWorkflow" },
    { "name": "throng-check", "binding": "CHECK", "class_name": "CheckWorkflow" },
  ],
  "triggers": {
    "events": [
      {
        "type": "cf.artifacts.repo.pushed",
        "filter": { "namespace": "throng-spike" },
        "targets": [{ "type": "workflow", "workflow_name": "throng-ingest" }],
      },
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "throng",
      // PLACEHOLDER: run `wrangler d1 create throng` and paste the id it prints here.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "CF_ACCOUNT_ID": "9ff7e9e225aeb0ab0c56b05b42ca2b13",
    "PREVIEW_WORKER": "throng-fixture-worker",
    // PLACEHOLDER: the Zero Trust team domain and the Access application's audience (AUD) tag.
    "ACCESS_TEAM_DOMAIN": "<team>.cloudflareaccess.com",
    "ACCESS_AUD": "<access-application-aud>",
  },
  "secrets": { "required": ["SPIKE_TOKEN", "CF_PREVIEW_TOKEN"] },
  "observability": { "enabled": true },
}
