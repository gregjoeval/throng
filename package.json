{
  "name": "throng",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy --config dist/throng/wrangler.json",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "spike": "tsx scripts/spike.ts"
  },
  "dependencies": {
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@types/node": "^22.20.5",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.9.1"
}
